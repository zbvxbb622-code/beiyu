# Copy to /opt/beiyu/.env on the ECS host and fill real values there.
# Do not commit real secrets.

# Current backend cannot use prod/staging until a real SMS provider is implemented.
# Keep this as dev for demo deployment with fixed OTP, or implement cloud SMS first.
BEIYU_ENVIRONMENT=dev
BEIYU_SMS_PROVIDER=development
BEIYU_SMS_DEVELOPMENT_CODE=123456

BEIYU_COMPOSE_POSTGRES_DB=beiyu
BEIYU_COMPOSE_POSTGRES_USER=beiyu
BEIYU_COMPOSE_POSTGRES_PASSWORD=replace-with-random-database-password
BEIYU_COMPOSE_DATABASE_URL=postgresql+psycopg://beiyu:replace-with-random-database-password@db:5432/beiyu

BEIYU_SECRET_KEY=replace-with-random-64-char-secret
BEIYU_CORS_ALLOWED_ORIGINS=

BEIYU_AI_ENABLED=true
BEIYU_AI_PROVIDER=aliyun
BEIYU_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BEIYU_AI_MODEL=replace-with-real-model-name
BEIYU_AI_API_KEY=replace-with-real-ai-api-key
BEIYU_AI_MEMORY_HMAC_KEY=replace-with-independent-random-64-char-memory-key
BEIYU_AI_DAILY_LIMIT=50
BEIYU_AI_REQUESTS_PER_MINUTE=10
BEIYU_AI_TIMEOUT_SECONDS=20
BEIYU_AI_RESERVATION_SECONDS=120
BEIYU_AI_CONTEXT_MESSAGES=20
BEIYU_AI_MEMORY_LIMIT=20

BEIYU_MEDIA_PROVIDER=oss
BEIYU_MEDIA_UPLOAD_MAX_BYTES=5242880
BEIYU_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
BEIYU_MEDIA_OSS_BUCKET=replace-with-oss-bucket
BEIYU_MEDIA_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
BEIYU_MEDIA_OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
BEIYU_MEDIA_OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
