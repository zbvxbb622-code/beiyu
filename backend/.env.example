# Host development commands connect through the published loopback port.
BEIYU_ENVIRONMENT=dev
BEIYU_DATABASE_URL=postgresql+psycopg://beiyu:beiyu@localhost:5432/beiyu
BEIYU_REDIS_URL=redis://localhost:6379/0
BEIYU_SECRET_KEY=change-me
BEIYU_ACCESS_TOKEN_MINUTES=15
BEIYU_REFRESH_TOKEN_DAYS=90
BEIYU_SMS_PROVIDER=development
BEIYU_SMS_DEVELOPMENT_CODE=123456
BEIYU_OTP_EXPIRES_SECONDS=300
BEIYU_OTP_RETRY_AFTER_SECONDS=60
BEIYU_OTP_MAX_ATTEMPTS=5
BEIYU_MAX_ACTIVE_DEVICES=5

# Docker Compose uses the internal "db" hostname. These are development-only
# placeholders. Keep the URL credentials/database synchronized with the three
# development database values below when overriding them.
BEIYU_COMPOSE_DATABASE_URL=postgresql+psycopg://beiyu:beiyu@db:5432/beiyu
BEIYU_COMPOSE_POSTGRES_DB=beiyu
BEIYU_COMPOSE_POSTGRES_USER=beiyu
BEIYU_COMPOSE_POSTGRES_PASSWORD=beiyu
BEIYU_COMPOSE_TEST_POSTGRES_USER=beiyu
BEIYU_COMPOSE_TEST_POSTGRES_PASSWORD=beiyu
